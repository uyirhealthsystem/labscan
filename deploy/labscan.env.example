# Copy to /opt/labscan/shared/labscan.env on the EC2 host and fill in.
# NEVER commit the real file.

NODE_ENV=production
PORT=8082
LOG_LEVEL=info

# Postgres (Neon / RDS). Used by the app; may be a pooled (-pooler) URL.
DATABASE_URL="postgresql://USER:CHANGE_ME@your-db-host/labscan?sslmode=require"

# Optional: direct (non-pooled) URL for `prisma migrate deploy`. If unset, the
# deploy script uses DATABASE_URL with the Neon "-pooler" host suffix removed.
# DIRECT_URL="postgresql://USER:CHANGE_ME@your-direct-db-host/labscan?sslmode=require"

# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=labscan-service
# KAFKA_GROUP_ID=labscan-service-group
